# Copy this file to .env and adjust values for your environment.
# No real secrets are included here.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Asia/Kolkata
SITE_NAME=EKAS Healthy Foods
PUBLIC_SITE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# ---- PostgreSQL ----
POSTGRES_USER=ekas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ekas

# ---- Celery ----
CELERY_TASK_ALWAYS_EAGER=False

# ---- CORS / CSRF / cookies ----
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Email (console backend is safe for local/dev) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EKAS Healthy Foods <no-reply@ekashealthyfoods.local>
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# ---- Payments (mock provider works with no credentials) ----
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shipping ----
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
FREE_SHIPPING_THRESHOLD=999
FLAT_SHIPPING_FEE=79
COD_ENABLED=True
DEFAULT_TAX_RATE_PERCENT=5.0
RESERVATION_EXPIRY_MINUTES=20

# ---- Initial Operations Portal Super Admin (bootstrapped by the `migrate` service) ----
OPERATIONS_ADMIN_EMAIL=admin@ekashealthyfoods.local
OPERATIONS_ADMIN_PASSWORD=change-me-before-first-boot

LOG_LEVEL=INFO

# ---- Frontend ----
FRONTEND_PORT=8080
